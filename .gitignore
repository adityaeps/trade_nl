# backend
backend/.venv/
backend/__pycache__/
**/__pycache__/
*.pyc
backend/.env
# Production DB connection string, kept out of the shell environment so
# one-off admin commands (seeding, dumps) can read it without it living in
# shell history. Contains a password - never commit.
backend/.render-db-url
backend/.neon-db-url
backend/.pytest_cache/
backend/.coverage

# frontend
frontend/node_modules/
frontend/.next/
frontend/.env.local
frontend/next-env.d.ts

# editors / os
.DS_Store
.vscode/
.idea/

# vercel
.vercel/
frontend/.vercel/
frontend/out/

# typescript incremental build cache (generated by `tsc --noEmit`)
frontend/tsconfig.tsbuildinfo

# Ruflo/claude-flow MCP local runtime state - session traces, its own
# project-memory sqlite DB (see memory_store calls), embedding index.
# Machine-local, not meant to be shared via git.
.claude-flow/
.swarm/
ruvector.db
.claude/.proven-config-version
.claude/proven-config.json

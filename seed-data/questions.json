          "deduction_type": "percentage",
          "deduction_value": 4,
          "flag_for_business_review": true
        },
        {
          "option_value": "heavily_used",
          "deduction_type": "percentage",
          "deduction_value": 13,
          "flag_for_business_review": true
        },

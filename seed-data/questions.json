{
  "note": "Real questionnaire content provided by the business, structured to match the ARCHITECTURE.md schema (see §5 questions/deduction_rules, §6 pricing engine). Deduction amounts are still illustrative placeholders layered onto the real question structure — see 'flag_for_business_review' on individual rules. Two open items are called out at the bottom under open_questions; resolve those before this goes live.",

  "question_sets": [
    { "local_id": "iphone_qs", "category": "phone", "brand": "apple", "name": "iPhone condition questionnaire" },
    { "local_id": "samsung_qs", "category": "phone", "brand": "samsung", "name": "Samsung condition questionnaire" }
  ],

  "iphone_questions": [
    {
      "local_id": "storage_capacity",
      "question_set": "iphone_qs",
      "text": "What is the storage capacity of the iPhone?",
      "type": "device_selector",
      "display_order": 1,
      "options": [
        { "label": "256GB", "value": "256" },
        { "label": "512GB", "value": "512" }
      ],
      "note": "Not a deduction question — this selects which device row (and base_price) the rest of the quote is calculated against. See ARCHITECTURE.md §6."
    },
    {
      "local_id": "overall_functional",
      "question_set": "iphone_qs",
      "text": "Is the iPhone working normally?",
      "type": "boolean",
      "display_order": 2,
      "options": [
        { "label": "Yes", "value": "yes" },
        { "label": "No", "value": "no" }
      ],
      "deduction_rules": [
        { "option_value": "yes", "deduction_type": "fixed", "deduction_value": 0 }
      ],
      "note": "If 'no', show the per-function checklist below (all depends_on this question = 'no')."
    },
    {
      "local_id": "sim_locked",
      "question_set": "iphone_qs",
      "text": "Is the device SIM-locked to a specific carrier?",
      "type": "boolean",
      "display_order": 3,
      "options": [
        { "label": "No", "value": "no" },
        { "label": "Yes", "value": "yes" }
      ],
      "deduction_rules": [
        { "option_value": "no", "deduction_type": "fixed", "deduction_value": 0 },
        { "option_value": "yes", "deduction_type": "fixed", "deduction_value": 0, "is_disqualifying": true, "disqualify_status": "rejected" }
      ],
      "note": "Hard exclusion per business rule ('we do not buy devices with SIM-lock'). No price shown at all — see ARCHITECTURE.md §6."
    },
    {
      "local_id": "water_damage",
      "question_set": "iphone_qs",
      "text": "Has the device been exposed to liquid or water damage?",
      "type": "boolean",
      "display_order": 4,
      "options": [
        { "label": "No", "value": "no" },
        { "label": "Yes", "value": "yes" }
      ],
      "deduction_rules": [
        { "option_value": "no", "deduction_type": "fixed", "deduction_value": 0 },
        { "option_value": "yes", "deduction_type": "fixed", "deduction_value": 0, "is_disqualifying": true, "disqualify_status": "manual_review" }
      ],
      "note": "Routed to manual review rather than a hard rejection, since severity varies — matches how BuyBack.nl/Swappie handle it (revised offer after physical inspection)."
    },
    {
      "local_id": "face_id_working",
      "question_set": "iphone_qs",
      "text": "Does Face ID (or Touch ID) unlocking work?",
      "type": "boolean",
      "display_order": 5,
      "depends_on": { "question": "overall_functional", "value": "no" },
      "options": [{ "label": "Yes", "value": "yes" }, { "label": "No", "value": "no" }],
      "deduction_rules": [
        { "option_value": "yes", "deduction_type": "fixed", "deduction_value": 0 },
        { "option_value": "no", "deduction_type": "fixed", "deduction_value": 30, "flag_for_business_review": true }
      ]
    },
    {
      "local_id": "powers_on",
      "question_set": "iphone_qs",
      "text": "Does the device power on?",
      "type": "boolean",
      "display_order": 6,
      "depends_on": { "question": "overall_functional", "value": "no" },
      "options": [{ "label": "Yes", "value": "yes" }, { "label": "No", "value": "no" }],
      "deduction_rules": [
        { "option_value": "yes", "deduction_type": "fixed", "deduction_value": 0 },
        { "option_value": "no", "deduction_type": "fixed", "deduction_value": 0, "is_disqualifying": true, "disqualify_status": "manual_review" }
      ],
      "note": "A device that won't power on at all isn't reliably assessable through a self-report questionnaire — routed to manual review rather than a fixed deduction."
    },
    {
      "local_id": "charges_normally",
      "question_set": "iphone_qs",

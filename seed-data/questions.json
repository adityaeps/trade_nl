        { "option_value": "no", "deduction_type": "fixed", "deduction_value": 10, "flag_for_business_review": true }
      ]
    },
    {
      "local_id": "screen_condition",
      "question_set": "iphone_qs",
      "text": "Is the screen in good condition and without damage?",
      "type": "single_select",
      "display_order": 13,
      "options": [
        { "label": "As new — no scratches or damage", "value": "as_new" },
        { "label": "Lightly used — minor superficial scratches", "value": "lightly_used" },
        { "label": "Heavily used — clearly visible, deeper scratches", "value": "heavily_used" },
        { "label": "Broken — cracked, shattered, non-original, discolored, or not working", "value": "broken" }
      ],
      "deduction_rules": [
        { "option_value": "as_new", "deduction_type": "fixed", "deduction_value": 0 },
        { "option_value": "lightly_used", "deduction_type": "fixed", "deduction_value": 15, "flag_for_business_review": true },
        { "option_value": "heavily_used", "deduction_type": "fixed", "deduction_value": 50, "flag_for_business_review": true },
        { "option_value": "broken", "deduction_type": "fixed", "deduction_value": 0, "is_disqualifying": true, "disqualify_status": "manual_review" }
      ],
      "note": "'Broken' covers too wide a range (hairline crack vs. shattered vs. non-original replacement screen) for a single fixed deduction — routed to manual review."
    },
    {
      "local_id": "housing_condition",
      "question_set": "iphone_qs",
      "text": "Is the housing in order and without damage?",
      "type": "single_select",
      "display_order": 14,
      "options": [
        { "label": "As new — perfect condition, no scratches", "value": "as_new" },
        { "label": "Lightly used — a few small scratches, no dents", "value": "lightly_used" },
        { "label": "Heavily used — visible scratches and/or minor dents", "value": "heavily_used" },
        { "label": "Broken — cracked, dented, heavily discolored, or bent", "value": "broken" }
      ],
      "deduction_rules": [
        { "option_value": "as_new", "deduction_type": "fixed", "deduction_value": 0 },
        { "option_value": "lightly_used", "deduction_type": "fixed", "deduction_value": 10, "flag_for_business_review": true },
        { "option_value": "heavily_used", "deduction_type": "fixed", "deduction_value": 30, "flag_for_business_review": true },
        { "option_value": "broken", "deduction_type": "fixed", "deduction_value": 0, "is_disqualifying": true, "disqualify_status": "manual_review" }
      ]
    },
    {
      "local_id": "battery_85",
      "question_set": "iphone_qs",
      "text": "Does the battery have a maximum capacity of at least 85%? (Settings > Battery > Battery Health > Maximum Capacity)",
      "type": "single_select",
      "display_order": 15,
      "options": [
        { "label": "Yes", "value": "yes" },
        { "label": "No", "value": "no" },
        { "label": "I am not sure", "value": "not_sure" }
      ],
      "deduction_rules": [
        { "option_value": "yes", "deduction_type": "fixed", "deduction_value": 0 },
        { "option_value": "no", "deduction_type": "fixed", "deduction_value": 25, "flag_for_business_review": true },
        { "option_value": "not_sure", "deduction_type": "fixed", "deduction_value": 0, "flag_for_business_review": true }
      ],
      "note": "'Not sure' currently carries no deduction and battery is re-checked at inspection. Business should decide whether to apply a conservative placeholder deduction instead, to hedge against overpaying when it turns out to be under 85%."
    }
  ],


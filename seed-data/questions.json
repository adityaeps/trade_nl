      "local_id": "screen_condition",
      "question_set": "iphone_qs",
      "text": "Is the screen in good condition and without damage?",
      "type": "single_select",
      "display_order": 13,
      "options": [
        {
          "label": "As new \u2014 no scratches or damage",
          "value": "as_new"
        },
        {
          "label": "Lightly used \u2014 minor superficial scratches",

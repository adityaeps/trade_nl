      "local_id": "storage_capacity",
      "question_set": "iphone_qs",
      "text": "What is the storage capacity of the iPhone?",
      "type": "device_selector",
      "display_order": 1,
      "options": [
        {
          "label": "256GB",
          "value": "256"
        },
        {
          "label": "512GB",
          "value": "512"
        }
      ],
      "note": "Not a deduction question \u2014 this selects which device row (and base_price) the rest of the quote is calculated against. See ARCHITECTURE.md \u00a76."
    },
    {
      "local_id": "overall_functional",
      "question_set": "iphone_qs",
      "text": "Is the iPhone working normally?",
      "type": "boolean",
      "display_order": 2,
      "options": [
        {
          "label": "Yes",
          "value": "yes"
        },
        {
          "label": "No",
          "value": "no"
        }
